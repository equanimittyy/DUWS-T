{
  "outputStyle": "Caveman",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/warn_comment_bloat.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 10,
            "statusMessage": "Checking comment bloat"
          }
        ]
      }
    ]
  }
}
