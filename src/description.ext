OnLoadMission = "DUWS BUT TACTICOOL";
onLoadName = "[BETA] DUWS-T v2.0";
dev = "dev";
author = "5U5, equanimity";
overviewText = "DUWS_T is a spiritual successor to DUWS_X, created by Killa Tomata. A long-term, persistent scenario: players must earn resources, carry out side missions, and lead BLUFOR forces to seize enemy-held zones, achieving total victory.";
overviewPicture = "duws\shared\media\images\duws_t.jpg";
LoadScreen = "duws\shared\media\images\duws_t.jpg";

// AIS INJURY
respawn = 3;
respawnDialog = 1;
respawndelay = 10;
disabledAI = 1;
enableDebugConsole = 1;
allowFunctionsLog = 1;
respawnOnStart=-1;

#include "modules\AIS\Effects\BarDlg.hpp"

//--------------------------------------------------------------

class CfgFunctions
{
	#include "modules\AIS\cfgFunctions.hpp"
};

// Rename the money item so the player's inventory and any engine-generated text read "Money", not
// the vanilla "Money Roll" -- "you need 5 Money Rolls" reads wrong for a currency. Money_roll is
// added and removed as a magazine (server/search/fnc_addRandomLoot.sqf, fnc_economy_init.sqf), so it
// lives in CfgMagazines; overriding only displayName merges over the base class and leaves the
// item's behaviour untouched.
class CfgMagazines
{
	class Money_roll
	{
		displayName = "Money";
	};
};

