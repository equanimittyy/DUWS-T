class RscTitles {
    class DUWST {
        idd = -1;
        movingEnable = false;
        duration = 5;
        class controls {
            class splash: RscPicture
		    {			
			idc = 1002;
			text = "duws\sounds_npics\support\DUWS_T.paa";
			x = 0.15 * safezoneW + safezoneX;
			y = 0.0 * safezoneH + safezoneY;
