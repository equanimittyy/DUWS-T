class RscTitles {
    class DUWST {
        idd = -1;
        movingEnable = false;
        duration = 5;
        class controls {
            class splash: RscPicture
		    {
			idc = 1002;
			text = "duws\shared\media\images\duws_t.paa";
			x = 0.15 * safezoneW + safezoneX;
			y = 0.0 * safezoneH + safezoneY;
			w = 0.7 * safezoneW;
			h = 1 * safezoneH;
			fade = 0;
		    };
        };
    };

    // Bottom-left radio log for SUB-NET dialogue. Held up for the whole mission (huge duration,
    // shown once from client_init) and updated in place: onLoad stashes the display so
    // fnc_duws_subnet_log can rewrite the structured-text control as lines arrive and age out.
    class DUWS_SubnetLog {
        idd = -1;
        movingEnable = false;
        duration = 1000000000;
        fadein = 0;
        fadeout = 0;
        onLoad = "uiNamespace setVariable ['DUWS_subnetDisplay', _this select 0];";
        class controls {
            class log: RscStructuredText {
                idc = 8812;
                x = 0.02 * safezoneW + safezoneX;
                y = 0.70 * safezoneH + safezoneY;
                w = 0.34 * safezoneW;
                h = 0.16 * safezoneH;
                size = 0.032;
                text = "";
                class Attributes {
                    font = "PuristaMedium";
                    color = "#ffffff";
                    align = "left";
                    valign = "bottom";
                    shadow = 1;
                };
            };
        };
    };

    // The OPCOM AI debug overlay (fnc_debug_opcom_ai_overlay). Bottom-aligned so it sits on the SUB-NET log and grows upward.
    class DUWS_OpcomAiLog {
        idd = -1;
        movingEnable = false;
        duration = 1000000000;
        fadein = 0;
        fadeout = 0;
        onLoad = "uiNamespace setVariable ['DUWS_opcomAiDisplay', _this select 0];";
        class controls {
            class log: RscStructuredText {
                idc = 8813;
                x = 0.02 * safezoneW + safezoneX;
                y = 0.08 * safezoneH + safezoneY;
                w = 0.34 * safezoneW;
                h = 0.61 * safezoneH;
                size = 0.026;
                text = "";
                class Attributes {
                    font = "PuristaMedium";
                    color = "#ffffff";
                    align = "left";
                    valign = "bottom";
                    shadow = 1;
                };
            };
        };
    };

    // The disguise suspicion bar (fnc_disguise_meter), in the OPCOM AI overlay's box, which only a debug
    // session opens. onLoad draws the last text itself, so the first draw does not depend on when the
    // display exists relative to the cutRsc that made it.
    class DUWS_DisguiseMeter {
        idd = -1;
        movingEnable = false;
        duration = 1000000000;
        fadein = 0;
        fadeout = 0;
        onLoad = "uiNamespace setVariable ['DUWS_disguiseMeterDisplay', _this select 0]; ((_this select 0) displayCtrl 8814) ctrlSetStructuredText parseText (missionNamespace getVariable ['DUWS_disguiseMeterText', '']);";
        class controls {
            class bar: RscStructuredText {
                idc = 8814;
                x = 0.02 * safezoneW + safezoneX;
                y = 0.28 * safezoneH + safezoneY;
                w = 0.34 * safezoneW;
                h = 0.41 * safezoneH;
                size = 0.032;
                text = "";
                class Attributes {
                    font = "PuristaMedium";
                    color = "#ffffff";
                    align = "left";
                    valign = "bottom";
                    shadow = 1;
                };
            };
        };
    };
};